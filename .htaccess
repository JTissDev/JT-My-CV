# Désactivation du listing des répertoires
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # =========================================================================
    # GESTION DES ENVIRONNEMENTS (Décommente la ligne correspondante)
    # =========================================================================
    
    # 1. Pour ton serveur de production IONOS (à la racine du domaine) :
    # RewriteBase /

    # 2. Pour ton environnement local Laragon (dans le sous-dossier /JT-Developpeur/) :
    RewriteBase /JT-Developpeur/

    # =========================================================================
    # ZONES PRIVÉES (A2) : lues par le code PHP via le système de fichiers,
    # jamais servies par une URL (403). Ces règles DOIVENT rester avant la
    # règle 1, qui laisserait passer tout fichier existant.
    # =========================================================================

    # Dossiers internes (NC : Windows/Laragon ne distingue pas Data de data)
    RewriteRule ^(data|src|classes|templates|vendor)(/|$) - [F,L,NC]
    RewriteRule ^print/(helpers|views)(/|$) - [F,L,NC]

    # Configuration, documentation et script de déploiement (deploy.lftp contient des identifiants)
    RewriteRule \.(md|json|lock|lftp)$ - [F,L,NC]

    # =========================================================================

    # 1. Ne pas réécrire si le fichier ou le dossier physique existe (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Règle pour le format /pagename/lang (ex: /accueil/fr ou /career/en)
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-z]{2})/?$ index.php?page=$1&lang=$2 [QSA,L]

    # 3. Règle de secours si seule la page est fournie
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [QSA,L]

</IfModule>