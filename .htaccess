# Désactivation du listing des répertoires
Options -Indexes

# =============================================================================
# EN-TÊTES DE SÉCURITÉ (A4)
# =============================================================================
# Derrière un proxy qui termine le HTTPS, Apache ne voit pas le chiffrement :
# on le déduit de X-Forwarded-Proto pour que le HSTS ci-dessous soit quand même envoyé.
<IfModule mod_setenvif.c>
    SetEnvIf X-Forwarded-Proto "^https$" HTTPS=on
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    # frame-ancestors : seul le site lui-même peut s'afficher dans une iframe (l'aperçu d'impression en utilise une).
    # base-uri : la balise <base href> ne peut pointer que vers le site (A5 : elle ne contient plus que son chemin).
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # HSTS : envoyé en HTTPS uniquement. Durée courte (1 h) pour le premier déploiement ;
    # à passer à 31536000 (1 an) une fois le HTTPS + www vérifié sur plusieurs jours.
    Header always set Strict-Transport-Security "max-age=3600" env=HTTPS
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pas de RewriteBase : Apache déduit le chemin de base du dossier qui contient ce
    # fichier. Le même fichier sert donc en local (Laragon, sous /JT-Developpeur/) et
    # en production (IONOS, à la racine du domaine), sans rien commenter ni décommenter.

    # =========================================================================
    # HTTPS ET WWW (A4) : uniquement pour le domaine de production, jamais en local.
    # Une seule redirection 301 vers l'adresse canonique, chemin et paramètres conservés.
    # =========================================================================

    # http -> https (+ www). Les 3 dernières conditions évitent toute boucle si le
    # chiffrement est géré en amont d'Apache (proxy) : HTTPS non vu mais X-Forwarded-Proto
    # ou port 443.
    RewriteCond %{HTTP_HOST} ^(www\.)?jtissier-developpeur-informatique\.fr$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://www.jtissier-developpeur-informatique.fr%{REQUEST_URI} [R=301,L]

    # https sans www -> https avec www
    RewriteCond %{HTTP_HOST} ^jtissier-developpeur-informatique\.fr$ [NC]
    RewriteRule ^ https://www.jtissier-developpeur-informatique.fr%{REQUEST_URI} [R=301,L]

    # =========================================================================
    # ZONES PRIVÉES (A2) : lues par le code PHP via le système de fichiers,
    # jamais servies par une URL (403). Ces règles DOIVENT rester avant la
    # règle 1, qui laisserait passer tout fichier existant.
    # =========================================================================

    # Dossiers internes (NC : Windows/Laragon ne distingue pas Data de data)
    RewriteRule ^(data|src|classes|templates|vendor)(/|$) - [F,L,NC]
    RewriteRule ^print/(helpers|views)(/|$) - [F,L,NC]

    # Configuration, documentation et script de déploiement (deploy.lftp contient des identifiants)
    RewriteRule \.(md|json|lock|lftp)$ - [F,L,NC]

    # =========================================================================

    # 1. Ne pas réécrire si le fichier ou le dossier physique existe (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Règle pour le format /pagename/lang (ex: /accueil/fr ou /career/en)
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-z]{2})/?$ index.php?page=$1&lang=$2 [QSA,L]

    # 3. Règle de secours si seule la page est fournie
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [QSA,L]
</IfModule>
